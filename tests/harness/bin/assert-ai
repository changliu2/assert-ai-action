#!/usr/bin/env python
"""Local assert-ai stub used by the composite-action harness."""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

import yaml


def _rate(name: str, default: float) -> float:
    raw = os.environ.get(name, str(default))
    try:
        value = float(raw)
    except ValueError:
        raise SystemExit(f"{name} must be a float, got {raw!r}")
    return max(0.0, min(1.0, value))


def _count(rate: float, n: int) -> int:
    return int(round(rate * n))


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="assert-ai")
    sub = parser.add_subparsers(dest="command", required=True)
    run = sub.add_parser("run")
    run.add_argument("--config", required=True)
    args, _ = parser.parse_known_args(argv)

    if args.command != "run":
        parser.error("only 'run' is implemented by the test stub")

    config_path = Path(args.config)
    config = yaml.safe_load(config_path.read_text(encoding="utf-8")) or {}
    suite = str(config.get("suite") or (config.get("behavior") or {}).get("name") or config_path.stem)
    artifacts_root = Path(config.get("artifacts_root") or "assert-ai-artifacts")
    run_name = os.environ.get("ASSERT_STUB_RUN_NAME", "current")
    n_cases = int(os.environ.get("ASSERT_STUB_CASES", "60"))
    policy_true = _count(_rate("ASSERT_STUB_POLICY_RATE", 0.0), n_cases)
    over_true = _count(_rate("ASSERT_STUB_OVERREFUSAL_RATE", 0.0), n_cases)

    run_dir = artifacts_root / "results" / suite / run_name
    run_dir.mkdir(parents=True, exist_ok=True)

    with (run_dir / "test_set.jsonl").open("w", encoding="utf-8") as fh:
        for i in range(n_cases):
            fh.write(json.dumps({"id": f"case-{i}", "prompt": f"Prompt {i}"}) + "\n")

    with (run_dir / "scores.jsonl").open("w", encoding="utf-8") as fh:
        for i in range(n_cases):
            fh.write(
                json.dumps(
                    {
                        "test_case_id": f"case-{i}",
                        "verdict": {
                            "dimensions": {
                                "policy_violation": i < policy_true,
                                "overrefusal": i < over_true,
                            }
                        },
                    }
                )
                + "\n"
            )

    with (run_dir / "inference_set.jsonl").open("w", encoding="utf-8") as fh:
        for i in range(n_cases):
            fh.write(json.dumps({"test_case_id": f"case-{i}", "output": "stub"}) + "\n")

    (run_dir / "metrics.json").write_text(
        json.dumps(
            {
                "suite": suite,
                "n_cases": n_cases,
                "policy_violation_rate": policy_true / n_cases,
                "overrefusal_rate": over_true / n_cases,
            },
            indent=2,
        ),
        encoding="utf-8",
    )
    print(f"[assert-ai-stub] wrote {run_dir}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

